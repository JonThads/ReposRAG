# --- Database ---
DATABASE_URL=postgresql://reposrag:CHANGE_ME@localhost:5432/reposrag

# Moved hard-coded credential as per Jira Ticket RAG-26
POSTGRES_USER=reposrag
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=reposrag

# --- Ollama ---
# If Ollama runs on your host machine (not in Docker), use host.docker.internal
OLLAMA_HOST=http://host.docker.internal:11434
OLLAMA_MODEL=qwen2.5:3b
# Retries on transient (timeout/connection) failures before failing the request.
OLLAMA_MAX_RETRIES=2
OLLAMA_RETRY_BACKOFF_SECONDS=0.5

# --- Embeddings ---
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DIM=384
# "auto" picks CUDA/MPS if available, else CPU. Override with "cpu"/"cuda"/"mps".
EMBEDDING_DEVICE=auto

# --- Retrieval ---
TOP_K=5
CHUNK_SIZE_TOKENS=500
CHUNK_OVERLAP_TOKENS=50

# --- API ---
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO

# Unset (default) disables auth entirely — fine for local/dev use.
# Set to require an "X-API-Key" header matching this value on /query,
# /query/stream, and /repos.
API_KEY=
RATE_LIMIT_PER_MINUTE=60
